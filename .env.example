# Plantilla de variables de entorno.
# Copiar a .env (cp .env.example .env) y cambiar los valores. Nunca subir .env al repositorio.

# Host donde corre MySQL
DB_HOST=127.0.0.1
# Puerto de MySQL
DB_PORT=3306
# Nombre de la base de datos
DB_NAME=parqueadero
# Usuario de la base de datos
DB_USER=parqueadero_user
# Contraseña del usuario (valor de ejemplo, cambiarlo)
DB_PASSWORD=cambiar_esta_clave
# Conexión cifrada (SSL) con MySQL: false en local (MySQL de Docker); true en
# producción (base en la nube, como Aiven). Opcional, por defecto false.
DB_SSL=false
#Contraseña del root (hay que cambiarla)
DB_ROOT_PASSWORD=cambia_esta_clave_root
# Puerto del servidor HTTP del backend (opcional, por defecto 8080)
PORT=8080
# Dirección del frontend que puede llamar a la API desde el navegador (CORS).
# Opcional, por defecto http://localhost:5173 (servidor de desarrollo de Vite).
# En producción, la URL pública del frontend.
CORS_ORIGIN=http://localhost:5173
# Primer usuario DBA de la aplicación (no es un usuario de MySQL). Al arrancar,
# si no hay ningún DBA activo, el backend lo crea con estos datos. Usuario: de 3
# a 30 caracteres en minúscula (letras, números, punto o guion bajo).
# Contraseña: mínimo 8 caracteres; cámbiala después de entrar por primera vez.
DBA_USUARIO=dba
DBA_CLAVE_INICIAL=cambia_esta_clave_dba
