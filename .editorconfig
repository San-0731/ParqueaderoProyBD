# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java y SQL: 4 espacios
[*.{java,sql}]
indent_style = space
indent_size = 4

# Frontend y configuración: 2 espacios
[*.{js,jsx,json,css,yml,yaml}]
indent_style = space
indent_size = 2

# En Markdown los espacios finales pueden ser saltos de línea intencionales
[*.md]
trim_trailing_whitespace = false
