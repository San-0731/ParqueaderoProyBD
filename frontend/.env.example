# Plantilla de variables de entorno del frontend.
# Copiar a .env.local (cp .env.example .env.local) y ajustar. .env.local no se sube al repositorio.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# URL base de la API del backend (incluye /api, sin barra final)
VITE_API_URL=http://localhost:8080/api
